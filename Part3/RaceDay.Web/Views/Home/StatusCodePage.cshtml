@model int
@{
    ViewData["Title"] = Model == 404 ? "Page not found" : "Something went wrong";
}
<div class="container rd-main">
    <div class="rd-empty">
        <div class="icon">@(Model == 404 ? "🧭" : "🛠️")</div>
        <h1 class="rd-section mt-2">@(Model == 404 ? "We could not find that page" : "Something went wrong")</h1>
        <p class="text-muted">
            @(Model == 404
                ? "The page or event you are looking for may have been moved or deleted."
                : "Please go back and try again.")
        </p>
        <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to RaceDay</a>
    </div>
</div>
