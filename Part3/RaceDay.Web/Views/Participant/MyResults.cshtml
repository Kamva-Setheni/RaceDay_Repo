@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
}
<div class="container rd-main">
    <p class="rd-eyebrow mb-1">Participant</p>
    <h1 class="rd-display fs-1">My results</h1>

    @if (ViewBag.Error is string error)
    {
        <div class="alert alert-warning">@error</div>
    }

    @if (!Model.Any())
    {
        <div class="rd-empty">
            <div class="icon">⏱️</div>
            <h3 class="mt-2">No results yet</h3>
            <p class="text-muted mb-0">Your race history appears here once an organiser has captured your finish time.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table rd-table align-middle">
                <thead>
                    <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Events" asp-action="Details" asp-route-id="@result.EventId">@result.EventName</a>
                            </td>
                            <td>@UiHelpers.DateShort(result.EventDate)</td>
                            <td>@result.CategoryName</td>
                            <td class="fw-semibold">@UiHelpers.FormatTime(result.FinishTime)</td>
                            <td>
                                @if (result.Status == "Finished" && result.Position is not null)
                                {
                                    <strong>@UiHelpers.Ordinal(result.Position.Value)</strong>
                                    <span class="text-muted"> out of @result.TotalFinishers finishers</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><partial name="_StatusBadge" model="result.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
